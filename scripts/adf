#!/bin/bash
#
# adf - Copy ADF config to target repositories
# Version: 1.2.0
#
# Usage: adf [command]
#   adf           - Copy .claude/ + CLAUDE.md (default, for Claude Code)
#   adf claude    - Same as default
#   adf ag        - Copy .agent/ + AGENTS.md (for Antigravity)
#   adf opencode  - Copy .claude/ + opencode.json + CLAUDE.md + .opencode/
#   adf codex     - Copy .claude/ + .codex/ + AGENTS.md + create .agents symlink
#   adf all       - Copy all tool configs (Claude, Antigravity, OpenCode, Codex)
#   adf help      - Show this help
#
# Setup: Set ADF_HOME env var or edit below
#

# ============================================
# CONFIGURATION
# ============================================
ADF_HOME="${ADF_HOME:-$HOME/adf}"
GIT_PROFILE="adf"

# ============================================
# COLORS
# ============================================
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# ============================================
# HELPERS
# ============================================
log_info() {
    echo -e "${BLUE}[ADF]${NC} $1"
}

log_success() {
    echo -e "${GREEN}[ADF]${NC} $1"
}

log_warn() {
    echo -e "${YELLOW}[ADF]${NC} $1"
}

log_error() {
    echo -e "${RED}[ADF]${NC} $1"
}

show_help() {
    cat << EOF
ADF - Copy ADF config to target repositories

Usage: adf [command] [--git-profile PROFILE]

Commands:
  adf           Copy .claude/ + CLAUDE.md (default, for Claude Code)
  adf claude    Same as default
  adf ag        Copy .agent/ + AGENTS.md (for Antigravity)
  adf opencode  Copy .claude/ + opencode.json + CLAUDE.md + .opencode/
  adf codex     Copy .claude/ + .codex/ + AGENTS.md + create .agents symlink
  adf all       Copy all tool configs (Claude, Antigravity, OpenCode, Codex)
  adf --update  Self-update this script from ADF_HOME
  adf help      Show this help

Git profiles:
  --git-profile adf   Use default ADF git convention (default)
  --git-profile cmc   Use CMC git convention overlays

Examples:
  adf opencode
  adf opencode --git-profile cmc
  adf all --git-profile adf

Setup:
  1. Set ADF_HOME env var OR edit this script
  2. Ensure ~/bin is in your PATH
  3. Run: chmod +x ~/bin/adf

Current ADF_HOME: $ADF_HOME
EOF
}

cmd_update() {
    local script_name="adf"
    local source="$ADF_HOME/scripts/$script_name"
    local target="$HOME/bin/$script_name"

    if [[ ! -f "$source" ]]; then
        log_error "Source not found: $source"
        exit 1
    fi

    if cp "$source" "$target" && chmod +x "$target"; then
        log_success "Updated: $target"
        log_info "Version: $(grep '^# Version:' "$target" 2>/dev/null | cut -d: -f2 || echo 'unknown')"
    else
        log_error "Failed to update"
        exit 1
    fi
}

validate_adf_home() {
    if [[ ! -d "$ADF_HOME" ]]; then
        log_error "ADF_HOME not found: $ADF_HOME"
        log_info "Set ADF_HOME env var or edit this script"
        exit 1
    fi
}

validate_write_permission() {
    if [[ ! -w "$TARGET" ]]; then
        log_error "No write permission in: $TARGET"
        exit 1
    fi
}

validate_node() {
    if ! command -v node >/dev/null 2>&1; then
        log_error "Node.js is required for git profile resolution"
        exit 1
    fi
}

is_known_command() {
    case "$1" in
        claude|ag|antigravity|opencode|oc|codex|all|help|--help|-h|--update|-u|update)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

resolve_git_profile_overlay() {
    if [[ "$GIT_PROFILE" == "adf" ]]; then
        return 0
    fi

    local manifest="$ADF_HOME/profiles/git-profiles.json"

    if [[ ! -f "$manifest" ]]; then
        log_error "Git profile manifest not found: $manifest"
        exit 1
    fi

    local overlay_path
    local node_output

    if ! node_output=$(node -e 'const fs=require("fs"); const manifest=JSON.parse(fs.readFileSync(process.argv[1], "utf8")); const profile=process.argv[2]; const config=manifest.profiles && manifest.profiles[profile]; if (!config) process.exit(2); if (profile === (manifest.defaultProfile || "adf")) process.exit(0); if (!config.overlayPath) process.exit(2); process.stdout.write(config.overlayPath);' "$manifest" "$GIT_PROFILE" 2>/dev/null); then
        log_error "Unknown git profile: $GIT_PROFILE"
        log_info "Available git profiles: adf, cmc"
        exit 1
    fi

    overlay_path="$node_output"

    if [[ "$GIT_PROFILE" != "adf" && -z "$overlay_path" ]]; then
        log_error "Git profile overlay path is empty for profile: $GIT_PROFILE"
        exit 1
    fi

    printf '%s\n' "$overlay_path"
}

validate_git_profile() {
    if [[ "$GIT_PROFILE" == "adf" ]]; then
        return 0
    fi

    validate_node
    local overlay_rel
    overlay_rel=$(resolve_git_profile_overlay)

    if [[ "$GIT_PROFILE" != "adf" && ! -d "$ADF_HOME/$overlay_rel" ]]; then
        log_error "Git profile overlay not found: $ADF_HOME/$overlay_rel"
        exit 1
    fi
}

is_known_git_profile() {
    local candidate="$1"
    local manifest="$ADF_HOME/profiles/git-profiles.json"

    if [[ -z "$candidate" || ! -f "$manifest" ]]; then
        return 1
    fi

    if ! command -v node >/dev/null 2>&1; then
        return 1
    fi

    node -e 'const fs=require("fs"); const manifest=JSON.parse(fs.readFileSync(process.argv[1], "utf8")); const profile=process.argv[2]; process.exit(manifest.profiles && manifest.profiles[profile] ? 0 : 1);' "$manifest" "$candidate" >/dev/null 2>&1
}

apply_git_profile_overlay() {
    local overlay_rel
    overlay_rel=$(resolve_git_profile_overlay)
    local overlay_root="$ADF_HOME/$overlay_rel"

    if [[ "$GIT_PROFILE" == "adf" ]]; then
        log_info "  ✓ Git profile: adf (default)"
        return
    fi

    if [[ ! -d "$overlay_root" ]]; then
        log_error "Git profile overlay not found: $overlay_root"
        exit 1
    fi

    if [[ -d "$overlay_root/.claude" && -d "$TARGET/.claude" ]]; then
        cp -r "$overlay_root/.claude/"* "$TARGET/.claude/"
        log_info "  ✓ Applied .claude git overlay ($GIT_PROFILE)"
    fi

    if [[ -d "$overlay_root/.agent" && -d "$TARGET/.agent" ]]; then
        cp -r "$overlay_root/.agent/"* "$TARGET/.agent/"
        log_info "  ✓ Applied .agent git overlay ($GIT_PROFILE)"
    fi

    log_info "  ✓ Git profile: $GIT_PROFILE"
}

parse_args() {
    local positional=()

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --git-profile)
                if [[ -z "$2" || "$2" == --* ]]; then
                    log_error "Missing value for --git-profile"
                    exit 1
                fi
                GIT_PROFILE="$2"
                shift 2
                ;;
            --git-profile=*)
                GIT_PROFILE="${1#*=}"
                if [[ -z "$GIT_PROFILE" ]]; then
                    log_error "Missing value for --git-profile"
                    exit 1
                fi
                shift
                ;;
            *)
                positional+=("$1")
                shift
                ;;
        esac
    done

    if [[ ${#positional[@]} -gt 0 ]]; then
        CMD="${positional[0]}"
    else
        CMD="claude"
    fi

    if [[ ${#positional[@]} -gt 2 ]]; then
        log_warn "Ignoring extra positional arguments: ${positional[*]:2}"
    fi

    if [[ ${#positional[@]} -eq 2 && "$GIT_PROFILE" == "adf" ]] && ! is_known_command "${positional[1]}"; then
        if is_known_git_profile "${positional[1]}"; then
            GIT_PROFILE="${positional[1]}"
            log_info "Interpreting trailing argument '${positional[1]}' as --git-profile ${positional[1]}"
        fi
    fi
}

# ============================================
# COMMANDS
# ============================================
cmd_claude() {
    validate_write_permission
    log_info "Copying Claude Code config to $TARGET"
    local failed=0

    # .claude/
    if cp -r "$ADF_HOME/.claude" "$TARGET/"; then
        log_info "  ✓ .claude/"
    else
        log_error "  ✗ .claude/"
        ((failed++))
    fi

    # CLAUDE.md
    if [[ -f "$ADF_HOME/CLAUDE.md" ]]; then
        if cp "$ADF_HOME/CLAUDE.md" "$TARGET/"; then
            log_info "  ✓ CLAUDE.md"
        else
            log_warn "  ✗ CLAUDE.md (skipped)"
        fi
    fi

    if [[ $failed -gt 0 ]]; then
        log_warn "Completed with $failed error(s)"
        exit 1
    fi
    apply_git_profile_overlay
    log_success "Done! Claude Code config copied"
}

cmd_antigravity() {
    validate_write_permission
    log_info "Copying Antigravity config to $TARGET"
    local failed=0

    # .agent/ (use -L to dereference symlinks)
    if [[ -d "$ADF_HOME/.agent" ]]; then
        if cp -rL "$ADF_HOME/.agent" "$TARGET/"; then
            log_info "  ✓ .agent/"
        else
            log_error "  ✗ .agent/"
            ((failed++))
        fi
    else
        log_warn "  ✗ .agent/ not found in ADF_HOME"
        ((failed++))
    fi

    # AGENTS.md
    if [[ -f "$ADF_HOME/AGENTS.md" ]]; then
        if cp "$ADF_HOME/AGENTS.md" "$TARGET/"; then
            log_info "  ✓ AGENTS.md"
        else
            log_warn "  ✗ AGENTS.md (skipped)"
        fi
    fi

    if [[ $failed -gt 0 ]]; then
        log_warn "Completed with $failed error(s)"
        exit 1
    fi
    apply_git_profile_overlay
    log_success "Done! Antigravity config copied"
}

cmd_opencode() {
    validate_write_permission
    log_info "Copying OpenCode config to $TARGET"
    local failed=0

    # .claude/
    if cp -r "$ADF_HOME/.claude" "$TARGET/"; then
        log_info "  ✓ .claude/"
    else
        log_error "  ✗ .claude/"
        ((failed++))
    fi

    # CLAUDE.md
    if [[ -f "$ADF_HOME/CLAUDE.md" ]] && cp "$ADF_HOME/CLAUDE.md" "$TARGET/"; then
        log_info "  ✓ CLAUDE.md"
    fi

    # opencode.json
    if [[ -f "$ADF_HOME/opencode.json" ]]; then
        if cp "$ADF_HOME/opencode.json" "$TARGET/"; then
            log_info "  ✓ opencode.json"
        else
            log_warn "  ✗ opencode.json (skipped)"
        fi
    fi

    # .opencode/
    if [[ -d "$ADF_HOME/.opencode" ]]; then
        if cp -r "$ADF_HOME/.opencode" "$TARGET/"; then
            log_info "  ✓ .opencode/"
        else
            log_warn "  ✗ .opencode/ (skipped)"
        fi
    fi

    if [[ $failed -gt 0 ]]; then
        log_warn "Completed with $failed error(s)"
        exit 1
    fi

    # Clean up Antigravity files that cause .agent/ path errors in OpenCode
    if [[ -f "$TARGET/AGENTS.md" ]]; then
        rm -f "$TARGET/AGENTS.md"
        log_info "  ✓ Removed AGENTS.md (not needed for OpenCode)"
    fi

    apply_git_profile_overlay
    log_success "Done! OpenCode config copied"
}

cmd_codex() {
    validate_write_permission
    log_info "Copying Codex config to $TARGET"
    local failed=0

    # .claude/
    if cp -r "$ADF_HOME/.claude" "$TARGET/"; then
        log_info "  ✓ .claude/"
    else
        log_error "  ✗ .claude/"
        ((failed++))
    fi

    # .codex/
    if [[ -d "$ADF_HOME/.codex" ]]; then
        if cp -r "$ADF_HOME/.codex" "$TARGET/"; then
            log_info "  ✓ .codex/"
        else
            log_error "  ✗ .codex/"
            ((failed++))
        fi
    else
        log_warn "  ✗ .codex/ not found in ADF_HOME"
        ((failed++))
    fi

    # AGENTS.md
    if [[ -f "$ADF_HOME/AGENTS.md" ]] && cp "$ADF_HOME/AGENTS.md" "$TARGET/"; then
        log_info "  ✓ AGENTS.md"
    fi

    # .agents symlink → .claude
    if [[ ! -e "$TARGET/.agents" ]]; then
        if ln -s .claude "$TARGET/.agents"; then
            log_info "  ✓ .agents → .claude (symlink)"
        else
            log_warn "  ✗ .agents symlink (skipped)"
        fi
    else
        log_warn "  ~ .agents already exists (skipped)"
    fi

    if [[ $failed -gt 0 ]]; then
        log_warn "Completed with $failed error(s)"
        exit 1
    fi
    apply_git_profile_overlay
    log_success "Done! Codex config copied"
}

cmd_all() {
    validate_write_permission
    log_info "Copying all ADF config to $TARGET"
    local failed=0

    # Claude Code
    if cp -r "$ADF_HOME/.claude" "$TARGET/"; then
        log_info "  ✓ .claude/"
    else
        log_error "  ✗ .claude/"
        ((failed++))
    fi

    if [[ -f "$ADF_HOME/CLAUDE.md" ]] && cp "$ADF_HOME/CLAUDE.md" "$TARGET/"; then
        log_info "  ✓ CLAUDE.md"
    fi

    # Antigravity
    if [[ -d "$ADF_HOME/.agent" ]]; then
        if cp -rL "$ADF_HOME/.agent" "$TARGET/"; then
            log_info "  ✓ .agent/"
        else
            log_warn "  ✗ .agent/ (skipped)"
        fi
    fi

    if [[ -f "$ADF_HOME/AGENTS.md" ]] && cp "$ADF_HOME/AGENTS.md" "$TARGET/"; then
        log_info "  ✓ AGENTS.md"
    fi

    # OpenCode
    if [[ -f "$ADF_HOME/opencode.json" ]] && cp "$ADF_HOME/opencode.json" "$TARGET/" 2>/dev/null; then
        log_info "  ✓ opencode.json"
    fi

    if [[ -d "$ADF_HOME/.opencode" ]] && cp -r "$ADF_HOME/.opencode" "$TARGET/" 2>/dev/null; then
        log_info "  ✓ .opencode/"
    fi

    # Codex
    if [[ -d "$ADF_HOME/.codex" ]]; then
        if cp -r "$ADF_HOME/.codex" "$TARGET/"; then
            log_info "  ✓ .codex/"
        else
            log_warn "  ✗ .codex/ (skipped)"
        fi
    fi

    # .agents symlink → .claude (Codex skill discovery)
    if [[ ! -e "$TARGET/.agents" ]]; then
        ln -s .claude "$TARGET/.agents" 2>/dev/null && log_info "  ✓ .agents → .claude (symlink)"
    else
        log_warn "  ~ .agents already exists (skipped)"
    fi

    # Optional files
    for f in .gitignore .env.example README.md; do
        if [[ -f "$ADF_HOME/$f" ]] && cp "$ADF_HOME/$f" "$TARGET/" 2>/dev/null; then
            log_info "  ✓ $f"
        fi
    done

    if [[ $failed -gt 0 ]]; then
        log_warn "Completed with $failed error(s)"
        exit 1
    fi
    apply_git_profile_overlay
    log_success "Done! All ADF config copied"
}

# ============================================
# MAIN
# ============================================
TARGET="${PWD}"
CMD="claude"

parse_args "$@"

# Route commands
case "$CMD" in
    help|--help|-h)
        show_help
        ;;
    --update|-u|update)
        validate_adf_home
        cmd_update
        ;;
    claude|"")
        validate_adf_home
        validate_git_profile
        cmd_claude
        ;;
    ag|antigravity)
        validate_adf_home
        validate_git_profile
        cmd_antigravity
        ;;
    opencode|oc)
        validate_adf_home
        validate_git_profile
        cmd_opencode
        ;;
    codex)
        validate_adf_home
        validate_git_profile
        cmd_codex
        ;;
    all)
        validate_adf_home
        validate_git_profile
        cmd_all
        ;;
    *)
        log_error "Unknown command: $CMD"
        show_help
        exit 1
        ;;
esac
